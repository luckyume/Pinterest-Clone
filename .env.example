# Copy to .env (or export in your shell) to customise a run.

# HTTP
PORT=3000
HOST=0.0.0.0

# GitHub OAuth web flow (leave unset to use the local development login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public origin used for the OAuth redirect_uri (defaults to the request origin)
BASE_URL=http://localhost:3000

# Development login only: the account opened when OAuth is not configured
DEV_LOGIN_USERNAME=octocat

# Session signing key (generated into data/.session-secret when omitted)
SESSION_SECRET=
